---
import BaseLayout from './BaseLayout.astro';
import LabChecklist from '../components/LabChecklist.astro';

interface ChecklistGroup {
  title: string;
  items: string[];
}
interface Props {
  title: string;
  description?: string;
  checklist?: ChecklistGroup[];
  storageKey?: string;
  lang?: 'en' | 'no';
  bookingSlug?: string;
}

const { title, description, checklist, storageKey, lang = 'en', bookingSlug } = Astro.props;
const hasChecklist = Array.isArray(checklist) && checklist.length > 0;
const bookingLabel = lang === 'no' ? 'Book labtid for denne oppgaven' : 'Book a lab session for this assignment';

const labels =
  lang === 'no'
    ? {
        title: 'Sjekkliste',
        reset: 'Nullstill',
        hint: 'Huk av etter hvert som du jobber deg gjennom — fremdriften lagres i denne nettleseren.',
      }
    : {
        title: 'Checklist',
        reset: 'Reset',
        hint: 'Tick things off as you go — your progress is saved in this browser.',
      };
---

<BaseLayout title={title} description={description}>
  {
    hasChecklist ? (
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:grid lg:grid-cols-[260px_minmax(0,1fr)] lg:items-start lg:gap-10 lg:px-8">
        <aside class="mb-8 lg:mb-0 lg:sticky lg:top-8">
          <LabChecklist storageKey={storageKey} groups={checklist} labels={labels} />
        </aside>
        <article>
          <h1 class="mb-4 text-3xl font-bold text-gray-900">{title}</h1>
          {description && (
            <p class={`text-lg text-gray-600 ${bookingSlug ? 'mb-4' : 'mb-8 border-b border-gray-200 pb-6'}`}>
              {description}
            </p>
          )}
          {bookingSlug && (
            <p class="mb-8 border-b border-gray-200 pb-6">
              <a
                href={`/${lang}/booking/?lab=${bookingSlug}`}
                class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
              >
                {bookingLabel}
              </a>
            </p>
          )}
          <div class="prose prose-slate max-w-none">
            <slot />
          </div>
        </article>
      </div>
    ) : (
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <article>
          <h1 class="mb-4 text-3xl font-bold text-gray-900">{title}</h1>
          {description && (
            <p class={`text-lg text-gray-600 ${bookingSlug ? 'mb-4' : 'mb-8 border-b border-gray-200 pb-6'}`}>
              {description}
            </p>
          )}
          {bookingSlug && (
            <p class="mb-8 border-b border-gray-200 pb-6">
              <a
                href={`/${lang}/booking/?lab=${bookingSlug}`}
                class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
              >
                {bookingLabel}
              </a>
            </p>
          )}
          <div class="prose prose-slate max-w-none">
            <slot />
          </div>
        </article>
      </div>
    )
  }
</BaseLayout>
