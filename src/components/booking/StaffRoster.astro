---
// Staff view of the bookings. Gated by src/middleware.ts — this is the only
// place student email addresses reach a page, so it must never be linked from
// the public navigation.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listBookingsForStaff } from '../../lib/booking/db';
import { getLabCatalog } from '../../lib/booking/catalog';
import { COURSES } from '../../lib/booking/courses';
import { labDates, osloToday, slotOf } from '../../lib/booking/logic';
import { LAB_ROOM } from '../../lib/room';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const no = locale === 'no';

const L = no
  ? {
      title: 'Bookingoversikt',
      intro: 'Kun for emneansvarlig. Siden er passordbeskyttet og lenkes ikke fra menyen.',
      upcoming: 'Kommende labdager',
      past: 'Passerte labdager',
      noUpcoming: 'Ingen kommende labdager med bookinger.',
      progress: 'Påmelding per lab',
      lab: 'Lab',
      booked: 'Påmeldt',
      ofCohort: 'av',
      remaining: 'mangler',
      nobody: 'Ingen påmeldte',
      group: 'Gruppe',
      csv: 'Last ned som CSV',
      failed: 'Kunne ikke hente bookinger fra databasen.',
      students: 'studenter',
      total: 'Totalt',
    }
  : {
      title: 'Booking overview',
      intro: 'Course staff only. This page is password protected and not linked from the menu.',
      upcoming: 'Upcoming lab days',
      past: 'Past lab days',
      noUpcoming: 'No upcoming lab days with bookings.',
      progress: 'Sign-ups per lab',
      lab: 'Lab',
      booked: 'Booked',
      ofCohort: 'of',
      remaining: 'missing',
      nobody: 'Nobody booked',
      group: 'Group',
      csv: 'Download as CSV',
      failed: 'Could not load bookings from the database.',
      students: 'students',
      total: 'Total',
    };

const catalog = await getLabCatalog(locale);
const labTitle = (id: string) => catalog.find((l) => l.id === id)?.title ?? id;
const labShort = (id: string) => catalog.find((l) => l.id === id)?.shortTitle ?? id;

let bookings: Awaited<ReturnType<typeof listBookingsForStaff>> = [];
let loadFailed = false;
try {
  bookings = await listBookingsForStaff();
} catch (err) {
  console.error('staff roster read failed:', err);
  loadFailed = true;
}

const today = osloToday();

/** Every lab day that has at least one booking, newest work first. */
const days = [...new Set(bookings.map((b) => b.date))].sort();
const upcoming = days.filter((d) => d >= today);
const past = days.filter((d) => d < today).reverse();

function courseOf(labId: string) {
  return COURSES.find((c) => c.labs.some((l) => l.id === labId)) ?? null;
}

/** Sessions on one day: slot → lab → the students booked into it. */
function sessionsOn(date: string) {
  const onDay = bookings.filter((b) => b.date === date);
  const slots = [...new Set(onDay.map((b) => b.slot))].sort((a, b) => a - b);
  return slots.map((slot) => {
    const inSlot = onDay.filter((b) => b.slot === slot);
    const course = courseOf(inSlot[0]?.labId ?? '');
    const period = course ? slotOf(course, slot) : null;
    const labIds = [...new Set(inSlot.map((b) => b.labId))].sort();
    return {
      slot,
      time: period ? `${period.start}–${period.end}` : '',
      labs: labIds.map((labId) => ({
        labId,
        groups: [...new Set(inSlot.filter((b) => b.labId === labId).map((b) => b.group))]
          .sort((a, b) => a - b)
          .map((group) => ({
            group,
            students: inSlot
              .filter((b) => b.labId === labId && b.group === group)
              .sort((a, b) => a.seat - b.seat),
          })),
      })),
      count: inSlot.length,
    };
  });
}

function formatDay(date: string) {
  return new Intl.DateTimeFormat(no ? 'nb-NO' : 'en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  }).format(new Date(`${date}T00:00:00Z`));
}

/** How far each lab is from getting the whole cohort through. */
const progress = COURSES.flatMap((course) =>
  course.labs.map((lab) => {
    const count = bookings.filter((b) => b.labId === lab.id).length;
    const capacity = labDates(lab.id).length * course.slots.length * lab.groupsPerSlot * lab.seatsPerGroup;
    return {
      course: course.id,
      labId: lab.id,
      count,
      cohort: course.cohortSize ?? 0,
      capacity,
    };
  })
);
---

<BaseLayout title={L.title} description={L.intro}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-ignore>
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">{L.title}</h1>
        <p class="mt-1 text-sm text-gray-500">{L.intro}</p>
      </div>
      <a
        href={`/api/staff/bookings.csv?locale=${locale}`}
        class="rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-gray-700 print:hidden"
      >
        {L.csv}
      </a>
    </div>

    {loadFailed && (
      <p class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {L.failed}
      </p>
    )}

    <!-- Sign-ups per lab: who still has to book -->
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{L.progress}</h2>
      <table class="mt-2 w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-400">
            <th scope="col" class="py-1.5 pr-3 font-semibold">{L.lab}</th>
            <th scope="col" class="py-1.5 pr-3 font-semibold">{L.booked}</th>
            <th scope="col" class="py-1.5 font-semibold">{L.remaining}</th>
          </tr>
        </thead>
        <tbody>
          {progress.map((p) => (
            <tr class="border-b border-gray-100">
              <td class="py-1.5 pr-3">
                <span class="text-xs font-semibold text-gray-400">{p.course}</span>
                <span class="ml-2 text-gray-900">{labShort(p.labId)}</span>
              </td>
              <td class="py-1.5 pr-3 tabular-nums text-gray-700">
                {p.count} {p.cohort > 0 && <span class="text-gray-400">{L.ofCohort} {p.cohort}</span>}
              </td>
              <td class="py-1.5 tabular-nums">
                {p.cohort > 0 && p.count < p.cohort ? (
                  <span class="font-semibold text-amber-700">{p.cohort - p.count}</span>
                ) : (
                  <span class="text-emerald-700">0</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- The bench sheet: who is coming to what, day by day -->
    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{L.upcoming}</h2>
      {upcoming.length === 0 ? (
        <p class="mt-2 text-sm text-gray-400">{L.noUpcoming}</p>
      ) : (
        upcoming.map((date) => (
          <article class="mt-4 break-inside-avoid rounded-xl border border-gray-200">
            <h3 class="border-b border-gray-100 px-4 py-2.5 text-sm font-semibold text-gray-900">
              {formatDay(date)}
              <span class="ml-2 font-normal text-gray-400">{LAB_ROOM}</span>
            </h3>
            {sessionsOn(date).map((session) => (
              <div class="border-b border-gray-100 px-4 py-3 last:border-0">
                <p class="text-xs font-semibold tabular-nums text-gray-600">
                  {session.time}
                  <span class="ml-2 font-normal text-gray-400">
                    {session.count} {L.students}
                  </span>
                </p>
                {session.labs.map((lab) => (
                  <div class="mt-2">
                    <p class="text-sm font-medium text-gray-900">{labTitle(lab.labId)}</p>
                    {lab.groups.map((g) => (
                      <ul class="mt-1 ml-1 space-y-0.5">
                        {lab.groups.length > 1 && (
                          <li class="text-xs font-semibold text-gray-400">
                            {L.group} {g.group}
                          </li>
                        )}
                        {g.students.map((s) => (
                          <li class="text-sm text-gray-700">
                            {s.studentName}
                            <a
                              href={`mailto:${s.studentEmail}`}
                              class="ml-2 text-xs text-blue-600 hover:underline"
                            >
                              {s.studentEmail}
                            </a>
                          </li>
                        ))}
                      </ul>
                    ))}
                  </div>
                ))}
              </div>
            ))}
          </article>
        ))
      )}
    </section>

    {past.length > 0 && (
      <section class="mt-10 print:hidden">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{L.past}</h2>
        {past.map((date) => (
          <details class="mt-2 rounded-lg border border-gray-200 px-4 py-2">
            <summary class="cursor-pointer text-sm text-gray-600">
              {formatDay(date)}
              <span class="ml-2 text-gray-400">
                {bookings.filter((b) => b.date === date).length} {L.students}
              </span>
            </summary>
            {sessionsOn(date).map((session) => (
              <div class="mt-2 text-sm text-gray-600">
                <p class="text-xs font-semibold tabular-nums text-gray-500">{session.time}</p>
                {session.labs.map((lab) => (
                  <p class="ml-1">
                    {labShort(lab.labId)}:
                    {lab.groups.flatMap((g) => g.students).map((s) => ` ${s.studentName}`).join(',')}
                  </p>
                ))}
              </div>
            ))}
          </details>
        ))}
      </section>
    )}
  </div>
</BaseLayout>
